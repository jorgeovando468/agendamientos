# Backend
PORT=4000
NODE_ENV=development
BASE_URL=http://localhost:4000
FRONTEND_URL=http://localhost:5173

# Database (MySQL via XAMPP, or SQLite fallback)
# For XAMPP (MySQL):
DB_DIALECT=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=root
DB_PASSWORD=
DB_NAME=agendamiento
DB_SSL=false

# To use SQLite (sin MySQL), set:
# DB_DIALECT=sqlite

# WhatsApp Cloud API (Meta)
WHATSAPP_TOKEN=your_whatsapp_token
WHATSAPP_PHONE_NUMBER_ID=your_phone_number_id
WHATSAPP_API_VERSION=v20.0

# API Auth (optional)
API_KEY=dev-key
